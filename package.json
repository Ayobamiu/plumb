{
  "name": "plumb",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @plumb/evals run eval",
    "dev:web": "pnpm --filter @plumb/web dev",
    "smoke:db": "cd packages/mcp-server && tsx --env-file=../../.env src/tools/smoke.ts",
    "smoke:meta": "cd packages/core && META_COST_LOG=../../logs/meta-calls.jsonl tsx --env-file=../../.env src/meta/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
