{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node integrations/cursor/hooks/session-start.mjs",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node integrations/cursor/hooks/after-agent-response.mjs",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "node integrations/cursor/hooks/stop.mjs",
        "timeout": 30,
        "loop_limit": 0
      }
    ]
  }
}
