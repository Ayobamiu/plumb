META_MODEL_API_KEY=
# Optional. Default muse-spark-1.3. Set when /v1/models for this key lists a different Spark id.
META_MODEL_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail OAuth (testing mode, gmail.readonly only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# MCP server bearer tokens (one per tool; revoke alone if leaked)
PLUMB_TOKEN_CLAUDE_CODE=
PLUMB_TOKEN_CURSOR=
PLUMB_TOKEN_CLAUDE_CHAT=
PLUMB_TOKEN_MUSE_CODE=
PLUMB_TOKEN_WATCHERS=
PLUMB_TOKEN_WEB=

# Point the homepage and hooks at the deployed (or local) MCP server
PLUMB_MCP_URL=http://127.0.0.1:8787/mcp
PLUMB_MCP_TOKEN=
PLUMB_INGEST_URL=http://127.0.0.1:8787/ingest
PLUMB_INGEST_TOKEN=
# Optional: API base for watchers (defaults from PLUMB_INGEST_URL or PLUMB_MCP_URL)
# PLUMB_API_URL=http://127.0.0.1:8787

# Default project for hooks / write-back
PLUMB_PROJECT_ID=

# Doc watcher (docs MCP). Railway needs a publicly reachable URL; the laptop
# text-editor binds 127.0.0.1 only, so leave these unset there until it is hosted.
# PLUMB_DOCS_URL=https://docs.example.com
# PLUMB_DOCS_TOKEN=
# Comma-separated doc ids to watch (never every doc)
# PLUMB_WATCH_DOCS=ede34f81-56d6-46e1-8189-691d8803f9eb
# Tab titles or ids never sent to /ingest (hashes still advance)
# PLUMB_DOCS_SKIP_TABS=7. Progress log

# Optional: override prompt dir when the server does not sit next to /prompts
# PLUMB_PROMPTS_DIR=

# Per user (Oct 28): env tokens above belong to this Supabase Auth user
PLUMB_OWNER_USER_ID=
# Homepage URL, for `npx plumb init` sign-in
PLUMB_WEB_URL=http://localhost:3000

# Stand-in model provider (OpenAI-compatible Responses API), only while Meta standard models are down.
# Leave unset to use Meta.
# PLUMB_MODEL_BASE_URL=https://api.openai.com/v1
# PLUMB_MODEL_API_KEY=
# PLUMB_MODEL_ID=gpt-5.4-nano
