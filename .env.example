META_MODEL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail OAuth (testing mode, gmail.readonly only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# MCP server bearer tokens (one per tool; revoke alone if leaked)
PLUMB_TOKEN_CLAUDE_CODE=
PLUMB_TOKEN_CURSOR=
PLUMB_TOKEN_CLAUDE_CHAT=
PLUMB_TOKEN_WATCHERS=
PLUMB_TOKEN_WEB=

# Point the homepage and hooks at the deployed (or local) MCP server
PLUMB_MCP_URL=http://127.0.0.1:8787/mcp
PLUMB_MCP_TOKEN=
PLUMB_INGEST_URL=http://127.0.0.1:8787/ingest
PLUMB_INGEST_TOKEN=
# Optional: API base for watchers (defaults from PLUMB_INGEST_URL or PLUMB_MCP_URL)
# PLUMB_API_URL=http://127.0.0.1:8787

# Default project for hooks / write-back
PLUMB_PROJECT_ID=

# Optional: override prompt dir when the server does not sit next to /prompts
# PLUMB_PROMPTS_DIR=
